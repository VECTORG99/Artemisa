# Server
PORT=3001
HOST=0.0.0.0
# Max time (ms) allowed for a single HTTP request before the server aborts it
REQUEST_TIMEOUT_MS=120000

# Logging
# Log verbosity: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Webhooks — comma-separated list of URLs notified on execution.started/completed/failed
# Leave empty to disable. URLs are validated against SSRF rules at send time (#248).
WEBHOOK_URLS=

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Metrics endpoint protection (required in production)
METRICS_SECRET=

# Frontend (build-time for Next.js, set in docker-compose or .env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_API_KEY=your-api-key-here

# LLM Provider
OPENAI_API_KEY=
MODEL_ID=gpt-4o
LLM_MOCK_MODE=false
MOCK_SCENARIO=happy_path
MOCK_SCENARIOS_PATH=

# Provider fallback chain (comma-separated: openai, anthropic, local)
LLM_PROVIDER_CHAIN=openai
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local / third-party OpenAI-compatible provider (used when chain includes "local").
# Works with any OpenAI Chat Completions-compatible endpoint: Ollama, LM Studio,
# vLLM, NVIDIA NIM (https://integrate.api.nvidia.com/v1), or free-tier gateways
# like OpenRouter (https://openrouter.ai/api/v1, use a model id ending in ":free").
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=gpt-oss:20b

# ReAct Loop
REACT_MAX_ITERATIONS=3
TOOL_RESULT_MAX_CHARS=8192
MCP_TIMEOUT_MS=30000

# RAG
RAG_MAX_CONTENT_CHARS=16000
FILE_ENCODING=utf8

# RAG root directory — files outside this path cannot be loaded
# Defaults to project root if unset
RAG_ROOT=.

# Vector Embeddings (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_TOP_K=5

# Persistence
HUASCAR_DB_PATH=./data/huascar.db
HISTORY_LIMIT_DEFAULT=20
RETENTION_EXECUTION_MAX_AGE_DAYS=90
RETENTION_EXECUTION_MAX_COUNT=10000
RETENTION_RAG_CHUNKS_MAX_PER_SOURCE=500
RETENTION_CLEANUP_ON_START=false

# MCP
MCP_STDERR=ignore

# MCP env var allowlist — only these vars can be interpolated in mcps.json
# Comma-separated. Prevents secret exfiltration via MCP process env.
MCP_ALLOWED_ENV_VARS=

# Security Policy
SECURITY_POLICY_PATH=./src/kiro/security-policy.json

# Bypass secret for emergency override of security hooks
# Set this to a strong random value; it will be redacted from logs automatically
BYPASS_SECRET=
# How long (ms) an activated admin bypass stays valid before auto-expiring
BYPASS_TTL_MS=60000

# Rate Limiting (requests per minute)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_EXECUTE=5
# The Creator re-evaluates the decision tree per step; a full Auto-largo run is
# ~35 requests, so this must stay well above the number of questions in the tree.
RATE_LIMIT_CREATOR=120

# Authentication
# Authentication is ENABLED by default. Set to false for local development only.
# In production, auth is enforced and the server will refuse to start without keys.
AUTH_REQUIRED=false
# Comma-separated list of valid API keys
HUASCAR_API_KEYS=

# Allow clients to override system_prompt via /api/agent/execute
# NEVER enable in production — allows complete prompt injection
ALLOW_CLIENT_SYSTEM_PROMPT=false

# Config Paths (override defaults)
STEERING_CONFIG_PATH=./src/kiro/steering.json
MCPS_CONFIG_PATH=./src/kiro/mcps.json
RAG_CONFIG_PATH=./src/kiro/rag.json
PROMPTS_DIR_PATH=./src/kiro/prompts

# GitHub (for MCP integration)
GITHUB_TOKEN=
