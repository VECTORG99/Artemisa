# syntax=docker/dockerfile:1
# Stage 1: Builder — install all deps, compile TypeScript, then prune to production deps
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts
COPY . .
RUN npx tsc
# Prune devDependencies in-place so the runner stage can copy a single
# node_modules instead of installing it twice.
RUN --mount=type=cache,target=/root/.npm \
    npm prune --omit=dev --ignore-scripts

# Stage 2: Runner — production image (no build tools)
FROM node:22-alpine AS runner
ENV NODE_ENV=production
RUN addgroup -S huascar && adduser -S huascar -G huascar
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
USER huascar
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const h=require('http');h.get('http://localhost:3001/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/server.js"]
