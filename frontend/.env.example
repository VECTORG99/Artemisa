# Backend API URL — must match the running backend
# Development: http://localhost:3001
# Docker: http://backend:3001 (set via docker-compose args)
NEXT_PUBLIC_API_URL=http://localhost:3001

# API key for protected Creator routes when AUTH_REQUIRED=true.
# In production (Render), copy the value from ARTEMISA_API_KEYS.
# Do not commit real production keys.
NEXT_PUBLIC_API_KEY=

# Canonical public URL for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
