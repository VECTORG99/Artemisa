# syntax=docker/dockerfile:1
# Stage 1: Install dependencies and build
FROM node:22-alpine AS builder
WORKDIR /app
COPY agent-creator/package.json agent-creator/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci
COPY agent-creator/ ./
RUN npm run build

# Stage 2: Serve static files as non-root user
FROM node:22-alpine AS runner
WORKDIR /app

# Install serve as a local dependency (not global) with exact version
RUN npm init -y && npm install --save-exact serve@14.2.4

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

# Copy built assets
COPY --from=builder --chown=appuser:appgroup /app/dist ./dist

# Switch to non-root user
USER appuser

EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:5173/ || exit 1
CMD ["npx", "serve", "-s", "dist", "-l", "5173"]
